{
  "name": "recipe-organiser",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "vercel-build": "pnpm db:migrate && pnpm build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "ALLOW_LOCAL_SIGNUP=true tsx --env-file=.env server/db/seedLocalUser.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.24",
    "@aws-sdk/client-s3": "^3.1115.0",
    "@aws-sdk/s3-request-presigner": "^3.1115.0",
    "@better-auth/drizzle-adapter": "1.7.0",
    "@iconify-json/lucide": "1.2.114",
    "@iconify-json/simple-icons": "1.2.87",
    "@internationalized/date": "3.12.2",
    "@neondatabase/serverless": "1.1.0",
    "@nuxt/test-utils": "4.0.3",
    "@nuxt/ui": "4.9.0",
    "@orpc/client": "1.14.8",
    "@orpc/server": "1.14.8",
    "@orpc/vue-colada": "1.14.8",
    "@pinia/colada": "1.3.1",
    "@pinia/colada-nuxt": "1.0.1",
    "@pinia/nuxt": "1.0.0",
    "@vueuse/core": "14.3.0",
    "@vueuse/nuxt": "14.3.0",
    "ai": "^7.0.42",
    "better-auth": "1.7.0",
    "drizzle-orm": "0.45.2",
    "effect": "4.0.0-beta.98",
    "formango": "3.2.5",
    "motion-v": "2.3.0",
    "nuxt": "4.4.8",
    "pg": "8.22.0",
    "pinia": "4.0.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.2.2",
    "tailwindcss": "4.3.1",
    "valibot": "1.4.2",
    "vue": "3.5.35",
    "vuedraggable": "4.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.98",
    "@nuxt/eslint": "1.16.0",
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "@vue/test-utils": "2.4.11",
    "@wisemen/eslint-config-vue": "2.1.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.7"
  },
  "packageManager": "pnpm@11.9.0"
}
