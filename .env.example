# Local Postgres started by docker compose
DATABASE_URL=postgresql://recipe:recipe@localhost:5432/recipe
# Optional override. Local defaults to pg; Vercel production defaults to Neon.
# DATABASE_DRIVER=pg

# Generate with: openssl rand -base64 32
# Use a unique value in Vercel; never reuse this example secret.
BETTER_AUTH_SECRET=replace-with-a-random-32-character-minimum-secret
BETTER_AUTH_URL=http://localhost:3000

# Local S3-compatible object storage (MinIO). These values are only for local
# development; use separate, strong credentials in any deployed environment.
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password
S3_BUCKET=recipe-images
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=password
S3_FORCE_PATH_STYLE=true

# Used only by the server to import recipe images with OpenAI.
OPENAI_API_KEY=
# Optional model override for recipe import.
OPENAI_RECIPE_IMPORT_MODEL=gpt-5-mini
